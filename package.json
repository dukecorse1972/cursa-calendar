{
  "name": "cursa-desktop",
  "productName": "Cursa",
  "version": "1.1.2",
  "description": "Desktop companion and academic productivity workstation for Google Calendar on Windows",
  "main": "dist/main/index.js",
  "scripts": {
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "build:ts": "tsc",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --external:electron --outfile=dist/preload/bundle.js",
    "build": "tsc && npm run build:preload",
    "watch": "tsc -w",
    "test": "npm run build && node --test dist/tests/core.test.js dist/tests/adapter.test.js dist/tests/validators.test.js dist/tests/selectors.test.js dist/tests/logger.test.js dist/tests/onboarding-palettes.test.js dist/tests/generalization-audit.test.js dist/tests/grades.test.js dist/tests/gcal-automation.test.js",
    "test:auth": "npm run build && electron src/tests/auth-flow.integration.js",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "shortcut": "node scripts/create-shortcut.js",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.cursa.desktop",
    "productName": "Cursa",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main/**/*",
      "dist/shared/**/*",
      "dist/preload/bundle.js",
      "!dist/**/*.map",
      "assets/icon.ico",
      "assets/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Cursa",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "installerSidebar": "assets/installer-sidebar.bmp",
      "uninstallerSidebar": "assets/installer-sidebar.bmp",
      "installerHeader": "assets/installer-header.bmp",
      "uninstallDisplayName": "Cursa Desktop",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "runAfterFinish": true
    }
  },
  "keywords": [
    "google-calendar",
    "academic",
    "student",
    "electron",
    "windows",
    "desktop",
    "productivity"
  ],
  "author": "Dario",
  "repository": {
    "type": "git",
    "url": "https://github.com/dukecorse1972/cursa.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "typescript": "^5.7.2"
  }
}
